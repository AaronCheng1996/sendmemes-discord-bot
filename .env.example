# This file is grouped by feature area (required vs. optional, then by
# service) rather than alphabetically, so keys are intentionally unordered.
# dotenv-linter:off UnorderedKey

# ============================================================================
# Required — the bot will not do anything useful until these are set.
# ============================================================================

# Discord bot token (Discord Developer Portal -> your app -> Bot -> Token).
DISCORD_TOKEN=your_bot_token

# Required for every /v1/admin/* request and the dashboard sign-in.
ADMIN_API_KEY=your_admin_api_key

# Media source: "pcloud" (default) or "local". Exactly one of the two blocks
# below applies, depending on this value.
MEDIA_SOURCE=pcloud

# --- MEDIA_SOURCE=pcloud: pCloud authentication -----------------------------
# Auth priority: PCLOUD_ACCESS_TOKEN (below) > PCLOUD_USERNAME + PCLOUD_PASSWORD.
# When PCLOUD_ACCESS_TOKEN is set, username/password are ignored.
#
# PCLOUD_ACCESS_TOKEN can be either:
#   - a session token: browser "pcauth" cookie while logged in to my.pcloud.com,
#     or from https://api.pcloud.com/userinfo?getauth=1&logout=1&username=EMAIL&password=PASS
#     -> leave PCLOUD_TOKEN_TYPE=session
#   - an OAuth2 access token from a registered pCloud app (does not expire until
#     the app is revoked) -> set PCLOUD_TOKEN_TYPE=oauth
# The token is region-bound: match PCLOUD_API_ENDPOINT to the account's region
# (locationid 1 = api.pcloud.com, 2 = eapi.pcloud.com).
PCLOUD_ACCESS_TOKEN=
# Option B: username + password (used when PCLOUD_ACCESS_TOKEN is empty)
#           Note: pCloud may require an email verification code from a new/unknown IP.
PCLOUD_USERNAME=your_pcloud_email
PCLOUD_PASSWORD=your_pcloud_password
# Comma-separated list of pCloud folder IDs to sync (supports one or more folders)
# e.g. CLOUD_MAIN_FOLDER_ID=11111,22222
CLOUD_MAIN_FOLDER_ID=your_main_folder_id

# --- MEDIA_SOURCE=local: local filesystem -----------------------------------
# Directory walked/served when MEDIA_SOURCE=local (e.g. a mounted ./media:/media
# volume — see docker-compose.yml). Expected layout:
# MEDIA_LOCAL_ROOT/<album name>/<file> (nesting under an album is fine).
MEDIA_LOCAL_ROOT=/media

# ============================================================================
# Optional — sensible defaults below, change if you need to.
# ============================================================================

# App identity (used in logs/metrics; no need to change)
APP_NAME=sendmemes-discord-bot
APP_VERSION=1.0.0

# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
HTTP_PUBLIC_URL=http://localhost:8080

# Logger
LOG_LEVEL=debug

# Database: set PG_URL directly, or use shared_env (POSTGRES_*) and config will
# build PG_URL. The defaults below work as-is with docker-compose.yml's own db
# service.
PG_POOL_MAX=2
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sendmemes
POSTGRES_SSL_MODE=disable

# Discord identity/behavior (empty DISCORD_APPLICATION_ID/GUILD_ID still let
# prefix commands and scheduled sends work; slash commands need them)
DISCORD_APPLICATION_ID=your_application_id
DISCORD_GUILD_ID=your_guild_id
# Channel for scheduled periodic album sends (empty = no scheduled rule seeded)
DISCORD_CHANNEL_ID=your_channel_id
# Channel for "new content discovered" sync notifications (empty = disabled)
DISCORD_NOTIFY_CHANNEL_ID=
# How often to push a random album to DISCORD_CHANNEL_ID (Go duration, e.g. 6h, 12h, 24h)
DISCORD_SEND_INTERVAL=5m
# How many of the most-recently-sent albums to skip when choosing the next scheduled album.
# When total albums ≤ this number, the history resets and all albums become eligible again.
DISCORD_SEND_HISTORY_SIZE=10
# Set to false to suppress per-request info logs (command received/completed, batch progress).
DISCORD_VERBOSE_LOG=true
# Default send_mode for albums created by sync and admin CreateAlbum calls
# that omit a mode. One of Order/Random/Single/Video/Custom.
ALBUM_DEFAULT_SEND_MODE=Random
# Per-message attachment budget in MB, and the floor for it: when the target
# server's Boost level grants more (Lv2 = 50, Lv3 = 100) that wins automatically.
# Set this to your account tier: 20 free, 50 Nitro Basic, 500 Nitro.
# Discord's cap has moved (25 -> 10 in Sept 2024 -> 20 in Aug 2026) and the
# increase does not reach every server at once. Set it too high and the bot
# recovers — a rejected message is retried with half the attachments — but each
# retry is a wasted upload, so it is worth matching to what your server takes.
DISCORD_UPLOAD_LIMIT_MB=20
# Albums with more images than this post one page at a time behind a
# "post more" button instead of dumping everything into the thread.
# 0 disables paging (always post the whole album).
FULL_ALBUM_PAGE_THRESHOLD=200
# How many images one such page carries.
FULL_ALBUM_PAGE_SIZE=100

# pCloud: additional settings beyond the required auth above
# Use https://eapi.pcloud.com for EU-hosted pCloud accounts
PCLOUD_API_ENDPOINT=https://api.pcloud.com
# "session" (sent as auth=) or "oauth" (sent as access_token=)
PCLOUD_TOKEN_TYPE=session
# How often to sync images from pCloud (Go duration, e.g. 1h, 30m)
PCLOUD_SYNC_INTERVAL=1h

# Toggle the Prometheus metrics handler
METRICS_ENABLED=true
